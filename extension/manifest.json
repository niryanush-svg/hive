{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.6.7",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "homepage_url": "https://hive-ny.pages.dev",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HIVE — multi-AI consultation"
  },
  "externally_connectable": {
    "matches": ["https://hive-ny.pages.dev/*"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
