{
  "name": "hive-encyclopedia-backend",
  "version": "0.1.0",
  "description": "HIVE Encyclopedia — Cloudflare Worker + D1 backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute hive-encyclopedia --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute hive-encyclopedia --remote --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^4.103.0"
  }
}
